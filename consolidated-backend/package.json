{
  "name": "consolidated-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "PRISMA_CLIENT_ENGINE_TYPE=binary tsx src/server.ts",
    "start": "tsx src/server.ts",
    "prisma:generate": "prisma generate --schema schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema schema.prisma",
    "test": "npm run prisma:generate && npm run prisma:migrate && tsx src/tests/api.e2e.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "body-parser": "^2.2.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "prisma": "^5.14.0",
    "tsx": "^4.21.0"
  }
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkDayStatus {
  DRAFT
  CLOSED
}

model WorkDay {
  id           Int           @id @default(autoincrement())
  date         DateTime      @default(now())
  startKm      Float?
  endKm        Float?
  startTime    DateTime?
  endTime      DateTime?
  totalEarning Float?
  status       WorkDayStatus @default(DRAFT)
  platforms    String[]
  expenses     Expense[]
  rides        Ride[]
  segments     WorkSegment[]

  @@map("work_days")
}

model Expense {
  id         Int       @id @default(autoincrement())
  workDayId  Int
  type       String
  amount     Float
  note       String?
  occurredAt DateTime?
  createdAt  DateTime  @default(now())

  workDay WorkDay @relation(fields: [workDayId], references: [id], onDelete: Cascade)

  @@index([workDayId])
  @@map("expenses")
}

model Ride {
  id              Int      @id @default(autoincrement())
  workDayId       Int?
  earning         Float
  distanceKm      Float
  durationMinutes Int
  fuelCost        Float?
  feeCost         Float?
  maintenanceCost Float?
  otherCost       Float?
  createdAt       DateTime @default(now())

  workDay WorkDay? @relation(fields: [workDayId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([workDayId])
  @@map("rides")
}

model WorkSegment {
  id          Int      @id @default(autoincrement())
  workDayId   Int
  origin      String
  destination String
  distanceKm  Float
  createdAt   DateTime @default(now())

  workDay WorkDay @relation(fields: [workDayId], references: [id], onDelete: Cascade)

  @@index([workDayId])
  @@map("work_segments")
}

model GeneralExpense {
  id         Int       @id @default(autoincrement())
  type       String
  amount     Float
  note       String?
  occurredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@map("general_expenses")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model WorkDay {
  id           Int       @id @default(autoincrement())
  startKm      Float
  endKm        Float?
  startTime    DateTime  @default(now())
  endTime      DateTime?
  totalEarning Float?
  expenses     Expense[]
  rides        Ride[]
  segments     WorkSegment[]

  @@map("work_days")
}

model Expense {
  id         Int      @id @default(autoincrement())
  workDayId  Int
  type       String
  amount     Float
  note       String?
  occurredAt DateTime?
  createdAt  DateTime @default(now())

  workDay    WorkDay  @relation(fields: [workDayId], references: [id], onDelete: Cascade)

  @@map("expenses")
  @@index([workDayId])
}

model Ride {
  id               Int       @id @default(autoincrement())
  workDayId        Int?
  earning          Float
  distanceKm       Float
  durationMinutes  Int
  fuelCost         Float?
  feeCost          Float?
  maintenanceCost  Float?
  otherCost        Float?
  createdAt        DateTime  @default(now())

  workDay          WorkDay?  @relation(fields: [workDayId], references: [id], onDelete: SetNull)

  @@map("rides")
  @@index([createdAt])
  @@index([workDayId])
}

model WorkSegment {
  id         Int      @id @default(autoincrement())
  workDayId  Int
  origin     String
  destination String
  distanceKm Float
  createdAt  DateTime @default(now())

  workDay    WorkDay  @relation(fields: [workDayId], references: [id], onDelete: Cascade)

  @@map("work_segments")
  @@index([workDayId])
}

model GeneralExpense {
  id         Int      @id @default(autoincrement())
  type       String
  amount     Float
  note       String?
  occurredAt DateTime?
  createdAt  DateTime @default(now())

  @@map("general_expenses")
  @@index([createdAt])
}
